# Copy to .env and fill in. Never commit .env.

# Meta Model API (https://api.meta.ai/v1) — key format: LLM|<id>|<secret>
MODEL_API_KEY=

# Open-weights host for the critic (Muse Spark Open). Required only when CRITIC_PROVIDER=open.
OPEN_WEIGHTS_BASE_URL=
OPEN_WEIGHTS_API_KEY=
OPEN_WEIGHTS_MODEL=meta-models/muse-spark-open-1026

# Provider for the critic agent: "meta" (Muse Spark) or "open" (Muse Spark Open). Other agents always use Meta.
CRITIC_PROVIDER=meta

# Hard stop for spend in one process, in USD. Meta's spend limit is only an email alert.
PSYCHE_BUDGET_USD=5
