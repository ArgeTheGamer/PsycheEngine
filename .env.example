# Copy to .env and fill in. Never commit .env.

# Meta Model API (https://api.meta.ai/v1) — key format: LLM|<id>|<secret>
MODEL_API_KEY=

# Open-weights host for the critic (Muse Spark Open). Leave empty to run the critic on Muse Spark.
OPEN_WEIGHTS_BASE_URL=
OPEN_WEIGHTS_API_KEY=
OPEN_WEIGHTS_MODEL=meta-models/muse-spark-open-1026

# Which provider each agent uses: "meta" or "open"
CRITIC_PROVIDER=meta

# Hard stop for spend in one process, in USD. Meta's spend limit is only an email alert.
PSYCHE_BUDGET_USD=5
